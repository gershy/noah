{
  
  "name": "@gershy/noah",
  "version": "0.0.1",
  "author": "Gershom Maes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gershy/noah.git"
  },
  
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  
  "type": "module",
  "files": [ "npm" ],
  "main": "./npm/noah.js",
  "types": "./npm/noah.d.ts",
  "exports": {
    ".": {
      "types": "./npm/noah.d.ts",
      "import": "./npm/noah.js"
    }
  },
  
  "scripts": {
    "npmDelete": "node -e \"fs.rmSync('./npm', { recursive: true, force: true })\"",
    "npmBundle": "tsc --project tsconfig.json",
    "npmShip": "npm whoami && npm run npmDelete && npm run npmBundle && npm publish --access public"
  }
  
}

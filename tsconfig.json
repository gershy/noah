{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./npm",
    "lib": [ "ES2025" ],
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "declaration": true,
    "declarationMap": true,
    "types": [ "node" ]
  },
  "include": [
    "src/**/*.ts"
  ]
}